rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The public staffing dashboards may read daily schedule overrides.
    // Only the designated administrator may create, update, or delete them.
    match /schedule_days/{dateKey}/{document=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == 'ymerDPrNiFXdDOC8yCfbqb6I5Li1';
    }
  }
}
